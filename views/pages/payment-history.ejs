<% locals.activePage='profile' %>
<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="auth-page" style="align-items:flex-start;padding-top:40px"><div class="auth-card auth-card--wide">
  <h2 class="auth-title">Payment History</h2><p class="auth-sub">Your Stripe transactions</p>
  <% if(!payments||!payments.length){ %><div class="empty-state" style="padding:40px 0"><div class="empty-icon">💳</div><p>No payments yet.</p><a href="/#pricing" class="btn btn-primary btn-sm" style="margin-top:12px">View Plans</a></div>
  <% }else{ %><div class="payments-table-wrap"><table class="payments-table"><thead><tr><th>Date</th><th>Plan</th><th>Amount</th><th>Status</th></tr></thead><tbody>
    <% payments.forEach(p=>{ %><tr><td><%= new Date(p.created_at).toLocaleDateString('en-US',{day:'numeric',month:'short',year:'numeric'}) %></td><td><span class="plan-badge plan-badge--<%= p.plan %>"><%= PLANS[p.plan]?PLANS[p.plan].label:p.plan %></span></td><td style="color:#4ade80;font-weight:700">$<%= Number(p.amount_usd).toFixed(2) %></td><td><span class="status-pill status-pill--<%= p.status %>"><%= p.status %></span></td></tr><% }) %>
  </tbody></table></div><% } %>
  <p class="auth-switch" style="margin-top:24px"><a href="/profile">← Back to profile</a></p>
</div></main>
<%- include('../partials/footer') %>
