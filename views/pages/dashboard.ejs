<% locals.activePage = 'dashboard' %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="tinder-app">
  <aside class="tinder-left">
    <div class="tl-header">
      <div class="tl-tabs">
        <button class="tl-tab active" id="tab-matches" onclick="switchTab('matches')">Matches</button>
        <button class="tl-tab" id="tab-messages" onclick="switchTab('messages')">Messages</button>
      </div>
    </div>
    <div class="tl-section" id="section-matches">
      <p class="tl-section-label">New Matches</p>
      <div class="new-matches-row">
        <% if (locals.newMatches && newMatches.length) { %>
          <% newMatches.forEach(m => { %>
            <a href="/chats/<%= m.match_id %>" class="nm-item">
              <div class="nm-avatar">
                <% if(m.avatar){ %><img src="<%= m.avatar %>" alt="<%= m.name %>"/><% } else { %><div class="nm-initial"><%= m.name.charAt(0) %></div><% } %>
                <span class="nm-online-dot"></span>
              </div>
              <span class="nm-name"><%= m.name.split(' ')[0] %></span>
            </a>
          <% }) %>
        <% } else { %>
          <div class="nm-empty">
            <div class="nm-empty-card"></div>
            <p>Start Matching</p>
            <p class="nm-empty-sub">Matches appear once you start liking people.</p>
          </div>
        <% } %>
      </div>
    </div>
    <div class="tl-section" id="section-messages" style="display:none">
      <% if (locals.recentChats && recentChats.length) { %>
        <% recentChats.forEach(m => { %>
          <a href="/chats/<%= m.match_id %>" class="tlm-item">
            <div class="tlm-ava"><% if(m.avatar){ %><img src="<%= m.avatar %>" alt="<%= m.name %>"/><% } else { %><div class="nm-initial"><%= m.name.charAt(0) %></div><% } %></div>
            <div class="tlm-info">
              <div class="tlm-name"><%= m.name %></div>
              <div class="tlm-preview"><%= m.last_msg || 'Say hello 👋' %></div>
            </div>
            <% if(m.unread>0){ %><span class="unread-badge"><%= m.unread %></span><% } %>
          </a>
        <% }) %>
      <% } else { %>
        <div style="padding:24px;text-align:center;color:var(--muted);font-size:13px">No conversations yet</div>
      <% } %>
    </div>
  </aside>
  <main class="tinder-center">
    <% if (locals.query && query.matched) { %>
      <div class="match-flash-banner" id="match-banner">
        <span>💖 It's a match with <strong><%= query.matched %></strong>!</span>
        <a href="/chats" class="btn btn-primary btn-sm">Send Message</a>
        <button onclick="document.getElementById('match-banner').remove()">✕</button>
      </div>
    <% } %>
    <div class="card-stack">
      <% if (profile) { %>
        <div class="tinder-card" id="tinder-card">
          <div class="tc-photo-wrap">
            <% if (profile.avatar) { %><img src="<%= profile.avatar %>" alt="<%= profile.name %>" class="tc-photo"/><% } else { %><div class="tc-photo tc-photo--placeholder"><%= profile.name.charAt(0) %></div><% } %>
            <div class="tc-label tc-label--like"  id="lbl-like">LIKE</div>
            <div class="tc-label tc-label--nope"  id="lbl-nope">NOPE</div>
            <div class="tc-label tc-label--super" id="lbl-super">SUPER</div>
            <button class="tc-expand-btn" onclick="toggleExpand()" id="expand-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg>
            </button>
          </div>
          <div class="tc-info" id="tc-info">
            <div class="tc-info-top">
              <div class="tc-name-row">
                <span class="tc-name"><%= profile.name %></span>
                <span class="tc-age"><%= profile.age %></span>
                <% if(profile.compatibility>=80){ %><span class="tc-online-dot"></span><% } %>
              </div>
              <% if(profile.bio){ %><p class="tc-bio"><%= profile.bio %></p><% } %>
            </div>
            <div class="tc-expanded" id="tc-expanded">
              <% if(profile.interests&&profile.interests.length){ %>
                <div class="tc-interests-label"><svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg> Interests</div>
                <div class="tc-interests"><% profile.interests.slice(0,5).forEach(i=>{ %><span class="tc-interest-tag"><%= i %></span><% }) %></div>
              <% } %>
              <div class="tc-compat-row"><span class="tc-compat-pct"><%= profile.compatibility %>% match</span></div>
            </div>
          </div>
        </div>
        <div class="tinder-card tinder-card--ghost"></div>
        <div class="tinder-card tinder-card--ghost2"></div>
      <% } else { %>
        <div class="card-empty"><div class="card-empty-inner"><div style="font-size:48px;margin-bottom:16px">✨</div><h3>You've seen everyone!</h3><p>Check back soon for new profiles.</p></div></div>
      <% } %>
    </div>
    <% if (profile) { %>
    <div class="tinder-actions">
      <form action="/dashboard/swipe" method="POST" id="form-rewind" style="display:inline">
        <input type="hidden" name="swiped_id" value="<%= profile.id %>"/><input type="hidden" name="action" value="dislike"/>
        <button type="button" class="ta-btn ta-btn--rewind" title="Rewind" onclick="animateSwipe('rewind')"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg></button>
      </form>
      <form action="/dashboard/swipe" method="POST" id="form-nope" style="display:inline">
        <input type="hidden" name="swiped_id" value="<%= profile.id %>"/><input type="hidden" name="action" value="dislike"/>
        <button type="button" class="ta-btn ta-btn--nope" title="Nope" onclick="animateSwipe('left')"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></button>
      </form>
      <form action="/dashboard/swipe" method="POST" id="form-super" style="display:inline">
        <input type="hidden" name="swiped_id" value="<%= profile.id %>"/><input type="hidden" name="action" value="superlike"/>
        <button type="button" class="ta-btn ta-btn--super" title="Super Like" onclick="animateSwipe('up')"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z"/></svg></button>
      </form>
      <form action="/dashboard/swipe" method="POST" id="form-like" style="display:inline">
        <input type="hidden" name="swiped_id" value="<%= profile.id %>"/><input type="hidden" name="action" value="like"/>
        <button type="button" class="ta-btn ta-btn--like" title="Like" onclick="animateSwipe('right')"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/></svg></button>
      </form>
    </div>
    <% } %>
  </main>
</div>
<script>
function switchTab(t){document.querySelectorAll('.tl-tab').forEach(b=>b.classList.remove('active'));document.getElementById('tab-'+t).classList.add('active');document.getElementById('section-matches').style.display=t==='matches'?'block':'none';document.getElementById('section-messages').style.display=t==='messages'?'block':'none';}
let expanded=false;
function toggleExpand(){expanded=!expanded;document.getElementById('tc-expanded').style.display=expanded?'block':'none';document.getElementById('tc-info').classList.toggle('tc-info--expanded',expanded);const btn=document.getElementById('expand-btn');if(btn)btn.style.transform=expanded?'rotate(180deg)':'';} 
function animateSwipe(dir){
  const card=document.getElementById('tinder-card');if(!card)return;
  const like=document.getElementById('lbl-like'),nope=document.getElementById('lbl-nope'),super_=document.getElementById('lbl-super');
  if(dir==='right'){card.classList.add('tc-swipe-right');if(like)like.style.opacity='1';setTimeout(()=>document.getElementById('form-like').submit(),400);}
  else if(dir==='left'){card.classList.add('tc-swipe-left');if(nope)nope.style.opacity='1';setTimeout(()=>document.getElementById('form-nope').submit(),400);}
  else if(dir==='up'){card.classList.add('tc-swipe-up');if(super_)super_.style.opacity='1';setTimeout(()=>document.getElementById('form-super').submit(),400);}
  else{card.classList.add('tc-bounce');setTimeout(()=>card.classList.remove('tc-bounce'),400);}
}
document.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')animateSwipe('left');if(e.key==='ArrowRight')animateSwipe('right');if(e.key==='ArrowUp')animateSwipe('up');});
const card=document.getElementById('tinder-card');
if(card){let sx=0,sy=0,drag=false;
  card.addEventListener('mousedown',e=>{sx=e.clientX;sy=e.clientY;drag=true;});
  card.addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY;drag=true;},{passive:true});
  document.addEventListener('mousemove',e=>{if(!drag)return;const dx=e.clientX-sx;card.style.transform=`translateX(${dx*0.4}px) rotate(${dx*0.03}deg)`;const lk=document.getElementById('lbl-like'),np=document.getElementById('lbl-nope');if(lk)lk.style.opacity=dx>30?Math.min((dx-30)/80,1):0;if(np)np.style.opacity=dx<-30?Math.min((-dx-30)/80,1):0;});
  document.addEventListener('mouseup',e=>{if(!drag)return;drag=false;const dx=e.clientX-sx,dy=e.clientY-sy;card.style.transform='';if(Math.abs(dx)>80)animateSwipe(dx>0?'right':'left');else if(dy<-80)animateSwipe('up');});
  document.addEventListener('touchend',e=>{if(!drag)return;drag=false;const dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;if(Math.abs(dx)>80)animateSwipe(dx>0?'right':'left');else if(dy<-80)animateSwipe('up');});
}
</script>
<%- include('../partials/footer') %>