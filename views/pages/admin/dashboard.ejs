<%- include('../../partials/head') %>
<nav class="tinder-nav"><div class="tn-left"><a href="/" class="tn-logo"><img src="/img/logo.svg" alt="HeartLink" class="tn-logo-img"/></a></div><div class="tn-right"><a href="/dashboard" class="btn btn-ghost btn-sm">App</a><form action="/auth/logout" method="POST" style="display:inline"><button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form></div></nav>
<main class="admin-main">
  <div class="admin-wrap">
    <div class="admin-sidebar">
      <p class="admin-sidebar-title">Admin Panel</p>
      <a href="/admin" class="admin-nav-link active">📊 Dashboard</a>
      <a href="/admin/users" class="admin-nav-link">👥 Users</a>
      <a href="/admin/payments" class="admin-nav-link">💳 Payments</a>
    </div>
    <div class="admin-content">
      <h1 class="admin-page-title">Dashboard</h1>
      <div class="admin-stats-grid">
        <div class="admin-stat-card"><div class="asc-icon">👥</div><div class="asc-n"><%= stats.totalUsers %></div><div class="asc-l">Total Users</div></div>
        <div class="admin-stat-card"><div class="asc-icon">🆕</div><div class="asc-n"><%= stats.activeToday %></div><div class="asc-l">Joined Today</div></div>
        <div class="admin-stat-card"><div class="asc-icon">💞</div><div class="asc-n"><%= stats.totalMatches %></div><div class="asc-l">Total Matches</div></div>
        <div class="admin-stat-card"><div class="asc-icon">💬</div><div class="asc-n"><%= stats.totalMessages %></div><div class="asc-l">Messages Sent</div></div>
        <div class="admin-stat-card asc-green"><div class="asc-icon">💳</div><div class="asc-n">$<%= Number(stats.revenue).toFixed(2) %></div><div class="asc-l">Revenue</div></div>
        <div class="admin-stat-card"><div class="asc-icon">⭐</div><div class="asc-n"><%= stats.plusUsers %></div><div class="asc-l">Plus Users</div></div>
        <div class="admin-stat-card"><div class="asc-icon">👑</div><div class="asc-n"><%= stats.vipUsers %></div><div class="asc-l">VIP Users</div></div>
        <div class="admin-stat-card asc-red"><div class="asc-icon">🚩</div><div class="asc-n"><%= stats.pendingReports %></div><div class="asc-l">Pending Reports</div></div>
      </div>

      <h2 class="admin-section-title">Recent Users</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Name</th><th>Email</th><th>Plan</th><th>Status</th><th>Joined</th><th>Action</th></tr></thead>
          <tbody>
            <% recentUsers.forEach(u => { %>
              <tr>
                <td><%= u.name %></td>
                <td style="color:var(--muted);font-size:12px"><%= u.email %></td>
                <td><span class="plan-badge plan-badge--<%= u.plan||'free' %>"><%= (u.plan||'free').toUpperCase() %></span></td>
                <td><span class="status-pill status-pill--<%= u.is_active?'confirmed':'failed' %>"><%= u.is_active?'Active':'Suspended' %></span></td>
                <td style="font-size:12px;color:var(--muted)"><%= new Date(u.created_at).toLocaleDateString() %></td>
                <td>
                  <form action="/admin/users/<%= u.id %>/toggle" method="POST" style="display:inline">
                    <button class="btn btn-ghost btn-sm" style="font-size:11px"><%= u.is_active?'Suspend':'Restore' %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (reports.length) { %>
      <h2 class="admin-section-title">Reports</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Reporter</th><th>Reported</th><th>Reason</th><th>Date</th><th>Action</th></tr></thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr>
                <td><%= r.reporter_name %></td>
                <td><%= r.reported_name %></td>
                <td><%= r.reason %></td>
                <td style="font-size:12px;color:var(--muted)"><%= new Date(r.created_at).toLocaleDateString() %></td>
                <td>
                  <% if(r.status==='pending'){ %>
                    <form action="/admin/reports/<%= r.id %>/resolve" method="POST" style="display:inline">
                      <button class="btn btn-primary btn-sm" style="font-size:11px">Resolve</button>
                    </form>
                  <% }else{ %><span style="color:var(--muted);font-size:12px">Resolved</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</main>
<script src="/js/main.js"></script></body></html>
