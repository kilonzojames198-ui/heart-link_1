<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="auth-page">
  <div class="auth-card">
    <h2 class="auth-title">Welcome back</h2>
    <p class="auth-sub">Sign in to your HeartLink account</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/auth/login" method="POST" class="auth-form">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@email.com" autofocus/>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Your password"/>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>
    <p class="auth-switch">Don't have an account? <a href="/auth/register">Join free</a></p>
  </div>
</main>
<%- include('../partials/footer') %>