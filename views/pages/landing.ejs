<script>
window.addEventListener('scroll',()=>{document.getElementById('navbar').classList.toggle('navbar--scrolled',window.scrollY>20);});
document.querySelectorAll('a[href^="#"],a[href^="/#"]').forEach(a=>{a.addEventListener('click',e=>{const h=(a.getAttribute('href').startsWith('/#')?a.getAttribute('href').slice(2):a.getAttribute('href').slice(1));const el=document.getElementById(h);if(el){e.preventDefault();el.scrollIntoView({behavior:'smooth'});}});});
let sd=false;function demoSwipe(dir){if(sd)return;sd=true;const c=document.getElementById('sc-front');c.classList.add(dir==='right'?'sc-swipe-right':dir==='left'?'sc-swipe-left':'sc-swipe-up');setTimeout(()=>{c.classList.remove('sc-swipe-right','sc-swipe-left','sc-swipe-up');sd=false;},600);}
</script>
